# Copy to .env and customise as needed. All values are optional —
# defaults are sensible for a local Ollama + Streamlit setup.

# LLM served by Ollama (e.g. llama3, mistral, llama2:13b).
MODEL=llama3

# HuggingFace sentence-transformers model used for embeddings.
EMBEDDINGS_MODEL_NAME=all-MiniLM-L6-v2

# Where Chroma persists the vector store.
PERSIST_DIRECTORY=db

# How many source chunks to retrieve per query.
TARGET_SOURCE_CHUNKS=4

# Where the Streamlit UI + example clients reach the Flask API.
API_URL=http://localhost:5000

# Set to 1 to enable Flask debug mode. NEVER enable in production —
# the debugger allows remote code execution if the API is reachable.
FLASK_DEBUG=0
